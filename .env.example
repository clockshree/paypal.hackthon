# PayPal Credentials & Configuration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Neon Postgres Database (serverless)
# If omitted or empty, fallback in-memory database will be used for local development
DATABASE_URL=

# Mode toggle: set to true to bypass PayPal network requests and return mock responses
USE_MOCKS=false

# Invoicer defaults
INVOICER_EMAIL=billing@paypilot.example.com
INVOICER_NAME=PayPilot Billing
DEFAULT_CURRENCY=USD
