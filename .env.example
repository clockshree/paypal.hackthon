# AI: free key from aistudio.google.com
GEMINI_API_KEY=

# PayPal sandbox: developer.paypal.com -> Apps & Credentials (Sandbox tab).
# Use a US business sandbox account and tick "Invoicing" under Features.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Leave blank so PayPal uses the app's own business account email
INVOICER_EMAIL=

# Optional Neon Postgres. If empty, an in-memory store is used.
DATABASE_URL=

# true = fake PayPal responses (no PayPal keys needed), false = real sandbox
USE_MOCKS=true

# Where the dashboard reads data from
NEXT_PUBLIC_API_BASE_URL=/api/ui